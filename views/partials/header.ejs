<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Barrel & Stone home">
      <% const logo = findImage('logo'); if (logo) { %>
        <img src="<%= logo %>" alt="Barrel & Stone" height="44">
      <% } else { %>
        <span class="wordmark">Barrel <span class="amp">&amp;</span> Stone</span>
      <% } %>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a href="/menu" <%- path === '/menu' ? 'aria-current="page"' : '' %>>Our pizzas</a>
      <a href="/find" <%- path === '/find' ? 'aria-current="page"' : '' %>>Find a pub</a>
      <a href="/for-pubs" <%- path === '/for-pubs' ? 'aria-current="page"' : '' %>>For pub owners</a>
      <a class="btn btn-tomato btn-sm" href="<%= site.delivery.justEat %>" rel="noopener">Order delivery</a>
    </nav>
  </div>
</header>
<main id="main">
